classDiagram
    namespace models {
        class EstadoEstudiante {
            <<enumeration>>
            REGULAR
            RESERVA_MATRICULA
            TRASLADO_INTERNO
            SUSPENDIDO
            EGRESADO
        }
        class Rol {
            <<enumeration>>
            PROFESOR
            ESTUDIANTE
        }
        class Curso {
            - idCurso: String 
            - nombreCurso: String 
            - totalHorasSesion: int
            - idProfesor: String
            - duracionCurso: int
            + String getIdCurso()
            + String getNombreCurso()
            + int getTotalHorasSesion()
            + String getIdProfesor()
            + int getDuracionCurso()
        }
        class Profesor {
            - id: String
            - nombre: String
            - apellido: String
            - correo: String
            - tipoDeDocumento: String
            - nroDocumento: String
            - telefono: int
            - departamentoAcademico: String
            - especialidad: String
            + String getId()
            + String getNombre()
            + String getApellido()
            + String getNombreCompleto()
            + String getCorreo()
            + int getTelefono()
            + String getTipoDeDocumento()
            + String getNroDocumento()
            + String getDepartamentoAcademico()
            + String getEspecialidad()
            + void mostrarPerfil()
        }
        class Estudiante {
            - id: String
            - codigo: String
            - nombres: String
            - apellidos: String
            - correo: String
            - escuelaProfesional: String
            - estado: EstadoEstudiante
            + String getId()
            + String getCodigo()
            + String getNombreCompleto()
            + String getCorreo()
            + String getEscuelaProfesional()
            + EstadoEstudiante getEstado()
            + void mostrarPerfil()
        }
        class Usuario {
            - id: String
            - correo: String
            - hashContrasena: String
            - rol: Rol
            - idReferencia: String
            - activo: boolean
            + String getId()
            + String getCorreo()
            + String getHashContrasena()
            + Rol getRol()
            + String getIdReferencia()
            + boolean isActivo()
            + boolean esProfesor()
            + boolean esEstudiante()
        }
        class RegistroDeAsistencia {
            - idAsistencia: String
            - idCurso: String
            - idEstudiante: String
            - fecha: String
            - horasAsistidas: int
            - presente: boolean
            + String getIdAsistencia()
            + void setIdAsistencia(String idAsistencia)
            + String getIdCurso()
            + String getIdEstudiante()
            + String getFecha()
            + int getHorasAsistidas()
            + boolean isPresente()
            + String toCsv()
        }
    }

    namespace service {
        class ServicioAcademico {
            + LIMITE_INASISTENCIA: double$
            + List~Profesor~ listarProfesores()
            + List~Estudiante~ listarEstudiantes()
            + Profesor buscarProfesor(String idProfesor)
            + Estudiante buscarEstudiante(String idEstudiante)
            + List~Curso~ listarCursos()
            + List~Curso~ listarCursosProfesor(Profesor profesor)
            + List~Estudiante~ listarEstudiantesCurso(Curso curso)
            + List~Curso~ listarCursosEstudiante(Estudiante estudiante)
            + List~RegistroDeAsistencia~ historialEstudiante(Estudiante estudiante)
            + void guardarAsistencias(List~RegistroDeAsistencia~ registros)
            + RegistroDeAsistencia crearRegistro(Curso curso, Estudiante estudiante, String fecha, int horasAsistidas, boolean presente)
            + double calcularPorcentajeFaltas(int horasDictadas, int horasAsistidas, int totalHorasCurso)
        }
        class AutenticacionService {
            + Usuario autenticar(String correo, String contrasena)
            - Usuario buscarPorCorreo(String correoNormalizado)
        }
    }

    namespace security {
        class PasswordHasher {
            - ALGORITMO: String$
            - PREFIJO: String$
            - ITERACIONES: int$
            - LONGITUD_CLAVE_BITS: int$
            - LONGITUD_SAL_BYTES: int$
            + String hash(String contrasena)$
            + boolean verificar(String contrasena, String almacenado)$
            - byte[] derivar(String contrasena, byte[] sal, int iteraciones)$
        }
    }

    namespace storage {
        class ArchivoManager {
            - CARPETA_DATOS: String$
            + List~Profesor~ leerProfesores()$
            + List~Estudiante~ leerEstudiantes()$
            + List~Usuario~ leerUsuarios()$
            + List~Curso~ leerCursos()$
            + List~String~ leerInscripcionesCurso(String idCurso)$
            + void guardarAsistencia(List~RegistroDeAsistencia~ registros)$
            + List~RegistroDeAsistencia~ leerAsistenciasEstudiante(String idEstudiante)$
            + List~RegistroDeAsistencia~ leerTodasAsistencias()$
            - boolean esPresente(String valor)$
        }
    }

    namespace sistema {
        class SistemaApp {
            - MAX_INTENTOS_LOGIN: int$
            - scanner: Scanner$
            - servicio: ServicioAcademico$
            - autenticacion: AutenticacionService$
            + void main(String[] args)$
            - int leerOpcion(String mensaje)$
            - void iniciarSesion()$
            - String leerContrasena(String mensaje)$
            - void menuProfesor(Profesor profActual)$
            - void gestionarCursosProfesor(Profesor prof)$
            - void menuEstudiante(Estudiante estActual)$
            - void mostrarResumenAsistenciaEstudiante(Estudiante est)$
        }
    }

    %% ==========================================
    %% Relaciones de Dominio (models)
    %% ==========================================
    Estudiante --> EstadoEstudiante : tiene
    Usuario --> Rol : tiene
    Usuario ..> Profesor : referencia por idReferencia
    Usuario ..> Estudiante : referencia por idReferencia
    Curso ..> Profesor : referencia por idProfesor
    RegistroDeAsistencia ..> Estudiante : referencia por idEstudiante
    RegistroDeAsistencia ..> Curso : referencia por idCurso

    %% ==========================================
    %% Relaciones entre Capas (Arquitectura)
    %% ==========================================
    SistemaApp --> ServicioAcademico : delega lógica de negocio
    SistemaApp --> AutenticacionService : inicia sesión
    AutenticacionService ..> PasswordHasher : verifica credenciales
    AutenticacionService ..> ArchivoManager : lee usuarios
    ServicioAcademico ..> ArchivoManager : persiste y recupera datos

    %% ==========================================
    %% Dependencias con el Dominio
    %% ==========================================
    
    SistemaApp ..> Profesor : interactúa
    SistemaApp ..> Estudiante : interactúa
    SistemaApp ..> Curso : interactúa
    SistemaApp ..> RegistroDeAsistencia : captura

    ServicioAcademico ..> Profesor : consulta
    ServicioAcademico ..> Estudiante : consulta
    ServicioAcademico ..> Curso : consulta
    ServicioAcademico ..> RegistroDeAsistencia : procesa / calcula faltas

    ArchivoManager ..> Profesor : deserializa CSV
    ArchivoManager ..> Estudiante : deserializa CSV
    ArchivoManager ..> Usuario : deserializa CSV
    ArchivoManager ..> Rol : parsea enum
    ArchivoManager ..> EstadoEstudiante : parsea enum
    ArchivoManager ..> Curso : deserializa CSV
    ArchivoManager ..> RegistroDeAsistencia : serializa / deserializa CSV
