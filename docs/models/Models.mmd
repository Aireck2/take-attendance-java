classDiagram
    namespace models{
        class EstadoEstudiante {
            <<enumeration>>
            REGULAR
            RESERVA_MATRICULA
            TRASLADO_INTERNO
            SUSPENDIDO
            EGRESADO
        }
        class Rol {
            <<enumeration>>
            PROFESOR
            ESTUDIANTE
        }
        class EstadoPlan {
            <<enumeration>>
            VIGENTE
            HISTORICO
        }
        class EstadoPeriodo {
            <<enumeration>>
            PLANIFICADO
            ACTIVO
            CERRADO
        }
        class Curso {
            - idCurso: String 
            - nombreCurso: String 
            - totalHorasSesion: int
            - idProfesor: String
            - duracionCurso: int
            - idModulo: String
            - creditos: int
            - horasTeoricas: int
            - horasPracticas: int
    
            + String getIdCurso()
            + String getNombreCurso()
            + int getTotalHorasSesion()
            + String getIdProfesor()
            + int getDuracionCurso()
            + String getIdModulo()
            + int getCreditos()
            + int getHorasTeoricas()
            + int getHorasPracticas()
            + int getHorasLectivasTotales()
        }
        class Carrera {
            - idCarrera: String
            - nombre: String
            + String getIdCarrera()
            + String getNombre()
        }
        class PlanEstudios {
            - idPlan: String
            - idCarrera: String
            - codigo: String
            - nombre: String
            - creditosTotales: int
            - horasTotales: int
            - estado: EstadoPlan
            + String getIdPlan()
            + String getIdCarrera()
            + String getCodigo()
            + String getNombre()
            + int getCreditosTotales()
            + int getHorasTotales()
            + EstadoPlan getEstado()
        }
        class ModuloProfesional {
            - idModulo: String
            - idPlan: String
            - nombre: String
            - competencia: String
            - creditosModulo: int
            + String getIdModulo()
            + String getIdPlan()
            + String getNombre()
            + String getCompetencia()
            + int getCreditosModulo()
        }
        class PeriodoAcademico {
            - idPeriodo: String
            - idPlan: String
            - codigo: String
            - fechaInicio: String
            - fechaFin: String
            - estado: EstadoPeriodo
            + String getIdPeriodo()
            + String getIdPlan()
            + String getCodigo()
            + String getFechaInicio()
            + String getFechaFin()
            + EstadoPeriodo getEstado()
        }
       class Profesor {
            - id: String
            - nombre: String
            - apellido: String
            - correo: String
            - tipoDeDocumento: String
            - nroDocumento: String
            - telefono: int
            - departamentoAcademico: String
            - especialidad: String
            + String getId()
            + String getNombre()
            + String getApellido()
            + String getNombreCompleto()
            + String getCorreo()
            + int getTelefono()
            + String getTipoDeDocumento()
            + String getNroDocumento()
            + String getDepartamentoAcademico()
            + String getEspecialidad()
            + void mostrarPerfil()
        }
        class Estudiante {
            - id: String
            - codigo: String
            - nombres: String
            - apellidos: String
            - correo: String
            - escuelaProfesional: String
            - estado: EstadoEstudiante
            + String getId()
            + String getCodigo()
            + String getNombreCompleto()
            + String getCorreo()
            + String getEscuelaProfesional()
            + EstadoEstudiante getEstado()
            + void mostrarPerfil()
        }

        class Usuario {
            - id: String
            - correo: String
            - hashContrasena: String
            - rol: Rol
            - idReferencia: String
            - activo: boolean
            + String getId()
            + String getCorreo()
            + String getHashContrasena()
            + Rol getRol()
            + String getIdReferencia()
            + boolean isActivo()
            + boolean esProfesor()
            + boolean esEstudiante()
        }

        class RegistroDeAsistencia {
            - idAsistencia: String
            - idCurso: String
            - idEstudiante: String
            - fecha: String
            - horasAsistidas: int
            - presente: boolean
            + String getIdAsistencia()
            + void setIdAsistencia(String idAsistencia)
            + String getIdCurso()
            + String getIdEstudiante()
            + String getFecha()
            + int getHorasAsistidas()
            + boolean isPresente()
            + String toCsv()
        }
    }

    Estudiante --> EstadoEstudiante : tiene
    Usuario --> Rol : tiene
    Usuario ..> Profesor : referencia por idReferencia
    Usuario ..> Estudiante : referencia por idReferencia
    Curso ..> Profesor : referencia por idProfesor
    RegistroDeAsistencia ..> Estudiante : referencia por idEstudiante
    RegistroDeAsistencia ..> Curso : referencia por idCurso
    Carrera --> PlanEstudios : administra
    PlanEstudios --> ModuloProfesional : organiza
    PlanEstudios --> PeriodoAcademico : operacionaliza
    ModuloProfesional --> Curso : agrupa
    PlanEstudios --> EstadoPlan : tiene
    PeriodoAcademico --> EstadoPeriodo : tiene
