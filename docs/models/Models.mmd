classDiagram
    namespace models{
        class EstadoEstudiante {
            <<enumeration>>
            REGULAR
            RESERVA_MATRICULA
            TRASLADO_INTERNO
            SUSPENDIDO
            EGRESADO
        }
        class Rol {
            <<enumeration>>
            PROFESOR
            ESTUDIANTE
        }
        class EstadoPlan {
            <<enumeration>>
            VIGENTE
            HISTORICO
        }
        class EstadoPeriodo {
            <<enumeration>>
            PLANIFICADO
            ACTIVO
            CERRADO
        }
        class Turno {
            <<enumeration>>
            MANANA
            TARDE
            NOCHE
        }
        class ModalidadDictado {
            <<enumeration>>
            PRESENCIAL
            VIRTUAL
            HIBRIDA
        }
        class DiaSemana {
            <<enumeration>>
            LUNES
            MARTES
            MIERCOLES
            JUEVES
            VIERNES
            SABADO
            DOMINGO
        }
        class TipoClase {
            <<enumeration>>
            TEORIA
            PRACTICA
        }
        class TipoSalon {
            <<enumeration>>
            AULA
            LABORATORIO
            TALLER
        }
        class EstadoMatricula {
            <<enumeration>>
            ACTIVA
            RETIRADA
            COMPLETADA
        }
        class EstadoComprobante {
            <<enumeration>>
            PAGADO
            PENDIENTE
            ANULADO
        }
        class Curso {
            - idCurso: String 
            - nombreCurso: String 
            - idModulo: String
            - creditos: int
            - horasTeoricas: int
            - horasPracticas: int
            - totalHorasSesion: int
            - duracionCurso: int
    
            + String getIdCurso()
            + String getNombreCurso()
            + String getIdModulo()
            + int getCreditos()
            + int getHorasTeoricas()
            + int getHorasPracticas()
            + int getTotalHorasSesion()
            + int getDuracionCurso()
            + int getHorasLectivasTotales()
        }
        class Carrera {
