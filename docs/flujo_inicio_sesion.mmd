---
config:
  theme: default
---
flowchart TB
    Menu[/"MENU PRINCIPAL - SISTEMA DE ASISTENCIA - IESTP CHINCHA<br>1. Iniciar sesion<br>2. Salir"/] --> LeerOp@{ label: "leerOpcion('Seleccione una opcion: ')" }
    LeerOp --> LeerInt["opcion = scanner.nextInt()<br>scanner.nextLine()"]
    LeerInt --> Switch{{"switch (opcion)"}}
    Switch -- 1 --> CallSesion[["Llamar iniciarSesion()"]]
    Switch -- 2 --> Salir@{ label: "Escribir 'Saliendo del sistema...'" }
    Switch -- default --> OpInvalida@{ label: "Escribir 'Opcion invalida.'" }
    OpInvalida --> Menu
    Salir --> Fin(["FIN"])
    CallSesion --> ReadCorreo[/"Leer correo y aplicar trim()"/]
    ReadCorreo --> ReadPass[/"Leer contrasena<br>Console.readPassword()"/]
    ReadPass --> Vacias{"correo vacio o contrasena vacia?"}
    Vacias -- Si --> AuthNull["AuthNull"]
    Vacias -- No --> CallBuscar[["Llamar buscarPorCorreo(correoNormalizado)"]]
    CallBuscar --> LeerUsuarios[["Llamar ArchivoManager.leerUsuarios()"]]
    LeerUsuarios --> VerifOk{"La contrasena coincide?"}
    VerifOk -- No --> AuthNull
    VerifOk -- Si --> AuthOk[/"Devolver usuario autenticado"/]
    AuthNull --> CredencialesInvalidas@{ label: "Escribir 'Credenciales invalidas.'<br>return → vuelve al menu principal" }
    CredencialesInvalidas --> VolverMenu["Volver al menu principal (repite el do-while)"]
    AuthOk --> RolMsg@{ label: "Escribir 'Sesion iniciada como ' + usuario.getRol()" }
    RolMsg --> SwitchRol{{"switch (usuario.getRol().menuSesion())"}}
    SwitchRol -- PROFESOR --> CallProf[["Llamar servicio.buscarProfesor(usuario.getIdReferencia())"]]
    SwitchRol -- ESTUDIANTE --> CallEst[["Llamar servicio.buscarEstudiante(usuario.getIdReferencia())"]]
    SwitchRol -- NINGUNO --> RolSinMenu@{ label: "Escribir 'El rol no tiene un menu asignado. Sesion cerrada.'<br>return → vuelve al menu principal" }
    RolSinMenu --> VolverMenu
    CallProf --> BienvProf@{ label: "Escribir 'Bienvenido, ' + profesor.getNombreCompleto()" }
    CallEst --> BienvEst@{ label: "Escribir 'Bienvenido, ' + estudiante.getNombreCompleto()" }
    BienvEst --> F(("E"))
    BienvProf --> E(("P"))
    F --> VolverMenu
    E --> VolverMenu
    VolverMenu --> Menu
    Start(["INICIO"]) --> Menu

    LeerOp@{ shape: lean-r}
    Salir@{ shape: lean-r}
    OpInvalida@{ shape: lean-r}
    CredencialesInvalidas@{ shape: lean-r}
    RolMsg@{ shape: lean-r}
    BienvProf@{ shape: lean-r}
    BienvEst@{ shape: lean-r}