---
config:
  layout: elk
  theme: default
---
flowchart TB
    P(("P")) --> ProfStart(["INICIO"])
    ProfStart --> MenuProf["MENU&nbsp;PROFESOR:&nbsp;nombre&nbsp;completo<br>1.&nbsp;Ver&nbsp;mis&nbsp;cursos&nbsp;asignados<br>2. Ver mi perfil<br>3. Cerrar sesion"]
    MenuProf --> LeerOpP@{ label: "leerOpcion('Elija una opcion: ')" }
    LeerOpP --> SwitchP{{"switch (opcProf)"}}
    SwitchP -- 1 --> CallCursos[["Llamar gestionarCursosProfesor(profActual)"]]
    SwitchP -- 2 --> PerfilP[["Llamar profActual.mostrarPerfil()"]]
    SwitchP -- 3 --> CerrarP[/"Cerrar sesion (opcion 3, sin acciones extra)"/]
    SwitchP -- default --> OpInvalidaP@{ label: "Escribir 'Opcion invalida.'" }
    PerfilP --> MenuProf
    OpInvalidaP --> MenuProf
    CallCursos --> Listar[["Llamar servicio.listarCursosProfesor(prof)"]]
    Listar --> ListarAlumnos[["Llamar servicio.listarEstudiantesCurso(cursoSel)"]]
    ListarAlumnos --> SinAlumnos{"La nomina esta vacia?"}
    SinAlumnos -- Si --> MsgSinAlumnos@{ label: "Escribir 'No hay alumnos inscritos en este curso.'<br>return" }
    SinAlumnos -- No --> PrintAlumnos[/"Escribir los alumnos matriculados<br>nombre completo y codigo"/]
    PrintAlumnos --> Pregunta@{ label: "leerOpcion('Desea tomar asistencia para este curso hoy? (1. Si / 2. No): ')" }
    Pregunta --> Tomar{"tomar == 1?"}
    Tomar -- Si --> Preparar["fecha = LocalDate.now().toString()<br>registros = new ArrayList&lt;&gt;()"]
    Preparar --> CabeceraAsis@{ label: "Escribir '--- REGISTRO DE ASISTENCIA ---'" }
    CabeceraAsis --> ForAlumno{{"Para cada alumno de alumnosCurso"}}
    ForAlumno --> MostrarAlumno@{ label: "Escribir 'Alumno: ' + nombre + ' (codigo)'" }
    MostrarAlumno --> LeerHoras@{ label: "leerOpcion('Horas asistidas (0 = ausente, maximo ' + totalHorasSesion + '): ')" }
    LeerHoras --> CrearRegistro[["Llamar servicio.crearRegistro(cursoSel, est, fecha, horasAsistidas)"]]
    CrearRegistro --> Agregar["registros.add(registro)"]
    Agregar --> K((" "))
    K --> ForAlumno
    ForAlumno -- Fin --> Guardar[["Llamar servicio.guardarAsistencias(registros)"]]
    Guardar --> AppendCsv[["Llamar ArchivoManager.guardarAsistencia(registros)<br>append en data/registro_de_asistencia.csv"]]

    LeerOpP@{ shape: lean-r}
    OpInvalidaP@{ shape: lean-r}
    MsgSinAlumnos@{ shape: lean-r}
    Pregunta@{ shape: lean-r}
    CabeceraAsis@{ shape: lean-r}
    MostrarAlumno@{ shape: lean-r}
    LeerHoras@{ shape: lean-r}
    linkStyle 8 stroke:#2962FF,fill:none