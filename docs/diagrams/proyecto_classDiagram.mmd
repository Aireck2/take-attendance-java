    %% ==========================================
    %% Relaciones de Arquitectura y Servicios
    %% ==========================================
    App "1" --> "1" ServicioAsistencia : ejecuta casos de asistencia
    App "1" --> "1" AutenticacionService : autentica sesiones
    AutenticacionService "1" --> "1" RepositorioUsuario : consulta cuentas
    AutenticacionService ..> PasswordHasher : verifica hashes
    ServicioAsistencia "1" --> "1" RepositorioAsistencia : consulta y persiste
    ServicioAsistencia "1" --> "1" RegistroAsistenciaService : delega registro
    ServicioAsistencia ..> CalendarioAcademico : consulta calendario
    RegistroAsistenciaService "1" --> "1" RepositorioAsistencia : valida datos
    RegistroAsistenciaService ..> RegistroAsistenciaFactory : crea registros
    RepositorioUsuario <|.. RepositorioUsuarioCsv : implementa
    RepositorioAsistencia <|.. RepositorioAsistenciaCsv : implementa
    RepositorioUsuarioCsv ..> AlmacenamientoUsuarioCsv : lee usuarios
    RepositorioAsistenciaCsv ..> AlmacenamientoAsistenciaCsv : consulta registros
    RepositorioAsistenciaCsv ..> AlmacenamientoCurriculoCsv : consulta curriculo
    RepositorioAsistenciaCsv ..> AlmacenamientoEstudianteCsv : consulta estudiantes
    RepositorioAsistenciaCsv ..> AlmacenamientoProfesorCsv : consulta profesores
    RepositorioAsistenciaCsv ..> AlmacenamientoProgramacionCsv : consulta programacion
    RepositorioAsistenciaCsv ..> PersistenciaAsistenciaCsv : delega guardado
    PersistenciaAsistenciaCsv ..> AlmacenamientoAsistenciaCsv : persiste filas

    %% ==========================================
    %% Relaciones del Modelo de Dominio (1 a N, etc.)
    %% ==========================================
    Carrera "1" *-- "1..*" PlanEstudios : organiza
    PlanEstudios "1" *-- "1..*" ModuloProfesional : estructura
    PlanEstudios "1" --> "1..*" PeriodoAcademico : planifica
    ModuloProfesional "1" *-- "1..*" Curso : compone
    Curso "1" <-- "1..*" SeccionCurso : dicta
    PeriodoAcademico "1" --> "1..*" BloqueSeccion : apertura
    BloqueSeccion "1" --> "1..*" SeccionCurso : agrupa
    BloqueSeccion "1" --> "0..*" Matricula : inscribe
    Estudiante "1" --> "0..*" Matricula : cursa
    SeccionCurso "1" --> "1..*" HorarioSeccion : programa
    Profesor "1" <-- "0..*" HorarioSeccion : asignado
    Salon "1" <-- "0..*" HorarioSeccion : asigna
    HorarioSeccion "1" --> "1..*" SesionClase : calendariza
    Profesor "1" <-- "0..*" SesionClase : dicta
    Salon "1" <-- "0..*" SesionClase : impartida en
    SesionClase "1" --> "0..*" RegistroDeAsistencia : registra
    Matricula "1" --> "0..*" RegistroDeAsistencia : vincula
    Estudiante "1" --> "0..*" RegistroDeAsistencia : asiste
    Curso "1" <-- "0..*" RegistroDeAsistencia : pertenece a
    SeccionCurso "1" --> "1..*" IndicadorLogro : evalua con
    IndicadorLogro "1" --> "0..*" RegistroNota : pondera
    Estudiante "1" --> "0..*" RegistroNota : obtiene
    DerechoPago "1" --> "0..*" ComprobantePago : tasa
    Estudiante "1" --> "0..*" ComprobantePago : paga
    Usuario "0..1" --> "0..1" Profesor : referencia profesor
    Usuario "0..1" --> "0..1" Estudiante : referencia estudiante

    %% ==========================================
    %% Asociaciones con Enumeraciones
    %% ==========================================
    Usuario --> Rol : rol
    Rol --> MenuSesion : menuSesion
    Estudiante --> EstadoEstudiante : estado
    Matricula --> EstadoMatricula : estado
    PlanEstudios --> EstadoPlan : estado
    PeriodoAcademico --> EstadoPeriodo : estado
    BloqueSeccion --> Turno : turno
    SeccionCurso --> ModalidadDictado : modalidad
    HorarioSeccion --> DiaSemana : diaSemana
    HorarioSeccion --> TipoClase : tipoClase
    Salon --> TipoSalon : tipo
    ComprobantePago --> EstadoComprobante : estado
