classDiagram
    direction TB

    namespace app {
        class App {
            - scanner : Scanner
            - servicioAsistencia : ServicioAsistencia
            - autenticacion : AutenticacionService
            + main(args : String[]) void
            + iniciar() void
            - iniciarSesion() void
            - gestionarCursosProfesor(prof : Profesor) void
            - mostrarDetalleCurso(seccion : SeccionCurso, curso : Curso) String
            - mostrarResumenAsistenciaEstudiante(est : Estudiante) void
        }
    }

    namespace servicio {
        class AutenticacionService {
            - repositorio : RepositorioUsuario
            + autenticar(correo : String, contrasena : String) Usuario
        }
        class ServicioAsistencia {
            - repositorio : RepositorioAsistencia
            - registro : RegistroAsistenciaService
            + listarEstudiantesDeCursoEnBloque(curso, idBloque) List~Estudiante~
            + buscarCarreraDeCurso(curso) Carrera
            + registrar(idSesion, idEstudiante, horasAsistidas) RegistroDeAsistencia
            + guardarLote(registros) void
            + calcularPorcentajeFaltas(horasDictadas, horasAsistidas) double
        }
        class RegistroAsistenciaService {
            - repositorio : RepositorioAsistencia
            ~ registrar(idSesion, idEstudiante, horasAsistidas) RegistroDeAsistencia
        }
        class RegistroAsistenciaFactory {
            ~ crear(sesion, curso, estudiante, horasAsistidas, idMatricula) RegistroDeAsistencia
        }
    }

    namespace security {
        class PasswordHasher {
            + hash(contrasena : String) String
            + verificar(contrasena : String, almacenado : String) boolean
        }
    }

    namespace repositorio {
        class RepositorioUsuario {
            <<interface>>
            + buscarPorCorreo(correo : String) Optional~Usuario~
        }
        class RepositorioAsistencia {
            <<interface>>
            + listarPorEstudiante(idEstudiante) List~RegistroDeAsistencia~
            + listarEstudiantesDeCursoEnBloque(curso, idBloque) List~Estudiante~
            + buscarCarreraDeCurso(curso) Optional~Carrera~
            + buscarMatriculaActiva(idEstudiante, idBloque) Optional~Matricula~
            + guardarLote(registros) void
        }
    }

    namespace almacenamiento_csv {
        class RepositorioUsuarioCsv {
            + buscarPorCorreo(correo) Optional~Usuario~
        }
        class RepositorioAsistenciaCsv {
            + listarPorEstudiante(idEstudiante) List~RegistroDeAsistencia~
            + guardarLote(registros) void
            + buscarCarreraDeCurso(curso) Optional~Carrera~
        }
        class AlmacenamientoAsistenciaCsv {
            ~ leerTodos() List~RegistroDeAsistencia~
            ~ agregar(registros) void
        }
        class AlmacenamientoCurriculoCsv {
            ~ leerCarreras() List~Carrera~
            ~ leerPlanesEstudios() List~PlanEstudios~
            ~ leerModulosProfesionales() List~ModuloProfesional~
        }
        class AlmacenamientoUsuarioCsv {
            ~ leerTodos() List~Usuario~
        }
        class PersistenciaAsistenciaCsv {
            ~ guardar(registros) void
        }
    }

    namespace modelo {
        class Usuario {
            - id : String
            - correo : String
            - hashContrasena : String
            - rol : Rol
            - idReferencia : String
            - activo : boolean
        }
        class Estudiante {
            - id : String
            - codigo : String
            - nombres : String
            - apellidos : String
            - correo : String
            - estado : EstadoEstudiante
        }
        class Curso {
            - idCurso : String
            - nombreCurso : String
            - idModulo : String
            - totalHorasSesion : int
        }
        class Carrera {
            - idCarrera : String
            - nombre : String
        }
        class PlanEstudios {
            - idPlan : String
            - idCarrera : String
        }
        class ModuloProfesional {
            - idModulo : String
            - idPlan : String
        }
        class Matricula {
            - idMatricula : String
            - idEstudiante : String
            - idBloque : String
            - estado : EstadoMatricula
        }
        class BloqueSeccion {
            - idBloque : String
            - idPeriodo : String
        }
        class SeccionCurso {
            - idSeccion : String
            - idBloque : String
            - idCurso : String
        }
        class HorarioSeccion {
            - idHorario : String
            - idSeccion : String
            - idProfesor : String
            - idSalon : String
        }
        class SesionClase {
            - idSesion : String
            - idHorario : String
            - fecha : String
            - horasProgramadas : int
        }
        class RegistroDeAsistencia {
            - idAsistencia : String
            - idCurso : String
            - idEstudiante : String
            - idSesion : String
            - idMatricula : String
            - horasAsistidas : int
        }
        class Rol {
            <<enumeration>>
            PROFESOR
            ESTUDIANTE
        }
        class EstadoMatricula {
            <<enumeration>>
            ACTIVA
            RETIRADA
            COMPLETADA
        }
        class EstadoEstudiante {
            <<enumeration>>
            REGULAR
            RESERVA_MATRICULA
            TRASLADO_INTERNO
            SUSPENDIDO
            EGRESADO
        }
    }

    App --> ServicioAsistencia : ejecuta casos de asistencia
    App --> AutenticacionService : autentica
    AutenticacionService --> RepositorioUsuario : consulta cuentas
    AutenticacionService ..> PasswordHasher : verifica contrasenas
    ServicioAsistencia --> RepositorioAsistencia : consulta y guarda
    ServicioAsistencia --> RegistroAsistenciaService : delega registro
    RegistroAsistenciaService --> RegistroAsistenciaFactory : crea registro validado
    RegistroAsistenciaService --> RepositorioAsistencia : resuelve sesion y matricula
    RepositorioUsuario <|.. RepositorioUsuarioCsv
    RepositorioAsistencia <|.. RepositorioAsistenciaCsv
    RepositorioUsuarioCsv ..> AlmacenamientoUsuarioCsv : lee usuarios
    RepositorioAsistenciaCsv ..> AlmacenamientoAsistenciaCsv : consulta registros
    RepositorioAsistenciaCsv ..> AlmacenamientoCurriculoCsv : resuelve carrera del curso
    RepositorioAsistenciaCsv ..> PersistenciaAsistenciaCsv : delega guardado
    PersistenciaAsistenciaCsv ..> AlmacenamientoAsistenciaCsv : asigna ID y agrega filas
    Usuario --> Rol
    Curso --> ModuloProfesional
    ModuloProfesional --> PlanEstudios
    PlanEstudios --> Carrera
    Matricula ..> Estudiante : referencia idEstudiante
    Matricula --> BloqueSeccion : referencia idBloque
    SeccionCurso --> Curso
    SeccionCurso --> BloqueSeccion
    SesionClase --> HorarioSeccion
    RegistroDeAsistencia --> SesionClase
    RegistroDeAsistencia --> Matricula
    Matricula --> EstadoMatricula : estado
