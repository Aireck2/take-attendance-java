flowchart TB
    App["app.App<br>CLI y menús por rol"]
    Auth["servicio.AutenticacionService"]
    Asistencia["servicio.ServicioAsistencia"]
    Registro["servicio.RegistroAsistenciaService<br>servicio.RegistroAsistenciaFactory"]
    RepoUsuario["repositorio.RepositorioUsuario<br>contrato"]
    RepoAsistencia["repositorio.RepositorioAsistencia<br>contrato"]
    CsvUsuario["almacenamiento.csv.RepositorioUsuarioCsv"]
    CsvAsistencia["almacenamiento.csv.RepositorioAsistenciaCsv"]
    Lectura["almacenamiento.csv.Almacenamiento*Csv"]
    Escritura["almacenamiento.csv.PersistenciaAsistenciaCsv"]
    Datos[("Archivos CSV en data/")]
    Hash["security.PasswordHasher"]
    Dominio["modelo.*<br>entidades y enumeraciones"]

    App -->|autentica| Auth
    App -->|invoca casos de asistencia| Asistencia
    Auth -->|consulta| RepoUsuario
    Auth -->|verifica credenciales| Hash
    Asistencia -->|coordina consultas y reglas| RepoAsistencia
    Asistencia --> Registro
    Registro -->|valida sesión, matrícula y horas| RepoAsistencia
    RepoUsuario -. implementación CSV .-> CsvUsuario
    RepoAsistencia -. implementación CSV .-> CsvAsistencia
    CsvUsuario --> Lectura
    CsvAsistencia --> Lectura
    CsvAsistencia --> Escritura
    Lectura -->|lee y reconstruye| Datos
    Escritura -->|agrega registros| Datos
    Auth --> Dominio
    Asistencia --> Dominio
    CsvAsistencia --> Dominio
