---
config:
  theme: default
---
flowchart TB
    Inicio([INICIO]) --> Menu["Sistema de asistencia<br>1. Iniciar sesión<br>2. Salir"]
    Menu --> LeerOpcion["leerOpcion() lee un entero y descarta el resto de la línea"]
    LeerOpcion --> Opcion{"Opción seleccionada"}
    Opcion -- "2" --> Salir["Escribir 'Saliendo del sistema...'"] --> Fin([FIN])
    Opcion -- "inválida" --> ErrorOpcion["Escribir 'Opción inválida.'"] --> Menu
    Opcion -- "1" --> Correo["Leer correo y quitar espacios externos"]
    Correo --> Contrasena["Leer contraseña<br>Console.readPassword() si hay consola;<br>si no, leer con Scanner"]
    Contrasena --> Auth["AutenticacionService.autenticar(correo, contraseña)"]
    Auth --> Usuario{"¿Credenciales válidas<br>y usuario activo?"}
    Usuario -- No --> Credenciales["Escribir 'Credenciales inválidas.'"] --> Menu
    Usuario -- Sí --> Rol{"Rol de la cuenta"}
    Rol -->|PROFESOR| PerfilProfesor["ServicioAsistencia.buscarProfesor(idReferencia)"]
    Rol -->|ESTUDIANTE| PerfilEstudiante["ServicioAsistencia.buscarEstudiante(idReferencia)"]
    Rol -->|sin menú| SinMenu["Informar que el rol no tiene menú<br>y cerrar sesión"] --> Menu
    PerfilProfesor --> ExisteProfesor{"¿Perfil encontrado?"}
    PerfilEstudiante --> ExisteEstudiante{"¿Perfil encontrado?"}
    ExisteProfesor -- No --> ErrorPerfilP["Informar perfil de profesor no encontrado"] --> Menu
    ExisteEstudiante -- No --> ErrorPerfilE["Informar perfil de estudiante no encontrado"] --> Menu
    ExisteProfesor -- Sí --> MenuProfesor["Dar bienvenida y abrir menú docente"] --> Cierre["Cerrar sesión"] --> Menu
    ExisteEstudiante -- Sí --> MenuEstudiante["Dar bienvenida y abrir menú estudiante"] --> Cierre
