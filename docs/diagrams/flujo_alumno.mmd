---
config:
  theme: default
---
flowchart TB
    E(("E")) --> EstStart(["INICIO"])
    EstStart --> MenuEst["MENU ESTUDIANTE: nombre&nbsp;completo<br>1.&nbsp;Ver&nbsp;cursos&nbsp;asignados&nbsp;y&nbsp;estado de asistencia<br>2. Ver mi perfil<br>3. Cerrar sesion"]
    MenuEst --> LeerOpE@{ label: "leerOpcion('Elija una opcion: ')" }
    LeerOpE --> SwitchE{{"switch (opcEst)"}}
    SwitchE -- 1 --> CallResumen[["Llamar mostrarResumenAsistenciaEstudiante(estActual)"]]
    SwitchE -- 2 --> PerfilE[["Llamar estActual.mostrarPerfil()"]]
    SwitchE -- 3 --> CerrarE[/"Cerrar sesion (opcion 3, sin acciones extra)"/]
    SwitchE -- default --> OpInvalidaE@{ label: "Escribir 'Opcion invalida.'" }
    PerfilE --> MenuEst
    OpInvalidaE --> MenuEst

    CallResumen --> Datos[["Llamar servicio.listarCursosEstudiante(est)<br>Llamar servicio.historialEstudiante(est)"]]
    Datos --> Cabecera@{ label: "Escribir 'RESUMEN DE ASISTENCIA Y CURSOS'" }
    Cabecera --> MenuEst
    LeerOpE@{ shape: lean-r}
    OpInvalidaE@{ shape: lean-r}
    Cabecera@{ shape: lean-r}