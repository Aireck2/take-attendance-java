flowchart TB
    Inicio([Inicio del menú estudiante]) --> Menu["1. Ver cursos asignados y estado de asistencia<br>2. Ver perfil<br>3. Cerrar sesión"]
    Menu --> Opcion["leerOpcion()"]
    Opcion --> Elegir{"Opción"}
    Elegir -- "2" --> Perfil["estudiante.mostrarPerfil()"] --> Menu
    Elegir -- "3" --> Salir([Cerrar sesión])
    Elegir -- inválida --> Error["Escribir 'Opción inválida.'"] --> Menu
    Elegir -- "1" --> Asistencias["ServicioAsistencia.listarPorEstudiante(idEstudiante)"]
    Asistencias --> Periodo["Buscar período académico activo"]
    Periodo --> HayPeriodo{"¿Existe período activo?"}
    HayPeriodo -- No --> SinPeriodo["Informar que no hay período activo"] --> Menu
    HayPeriodo -- Sí --> Matriculas["Recorrer matrículas activas del estudiante"]
    Matriculas --> Bloque["Validar que el bloque corresponda al período activo"]
    Bloque --> Secciones["Recorrer secciones del bloque y obtener sus cursos"]
    Secciones --> Resumen["Calcular horas dictadas, horas asistidas<br>y porcentaje de inasistencia por curso"]
    Resumen --> Mostrar["Mostrar período, curso, bloque, docentes,<br>horarios y porcentaje de inasistencia"]
    Mostrar --> Menu
    Bloque -. datos consultados mediante .-> Servicio["ServicioAsistencia"]
    Servicio -. acceso a datos .-> Repositorio["RepositorioAsistenciaCsv<br>y almacenamiento CSV"]
